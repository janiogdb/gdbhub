local function rarityStyle(info)
 if not info then return {nil,'Não identificada'} end
 if info.secret then return rarityStyles.secret end
 local key=string.lower((string.gsub(tostring(info.rarity or ''),'^%s*(.-)%s*$','%1')))
 return rarityStyles[key] or {nil,tostring(info.rarity or 'Não identificada')}
end
local function rarityImage(parent,info,position,size)
 local style=rarityStyle(info); local asset=style[1] and images[style[1]]
 if asset then return make('ImageLabel',{Name='RarityBadge',Position=position,Size=size,BackgroundTransparency=1,Image=asset,ScaleType=Enum.ScaleType.Fit,Active=false},parent) end
 return nil
end

make=function(class,props,parent)
 local x=Instance.new(class)
 for key,value in pairs(props) do
  local ok,err=pcall(function() x[key]=value end)
  if not ok then x:Destroy(); error('Falha criando '..class..'.'..key..': '..tostring(err),2) end
 end
 if x:IsA('GuiObject') and props.LayoutOrder==nil then x.LayoutOrder=#parent:GetChildren()+1 end
 x.Parent=parent; return x
end
