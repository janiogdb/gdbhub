local movementStatus=note(left,'Deslocamento desligado. Ataque automático não integrado.')
local bossCursor=1
local previousBoss
local defeatedParts=setmetatable({},{__mode='k'})
local function livePart(part)
 if not part or not part.Parent or not part:IsDescendantOf(workspace) or not part:IsA('BasePart') then return false end
 local dead=part:GetAttribute('Dead')
 local hp=tonumber(part:GetAttribute('HP'))
 return dead~=true and dead~='true' and hp~=nil and hp>0
end
local function positionOf(record)
 local enemies=workspace:FindFirstChild('_ENEMIES')
 for _,folderName in ipairs({'Client','InRange'}) do
  local folder=enemies and enemies:FindFirstChild(folderName)
  local model=folder and folder:FindFirstChild(record.Name)
  if model and model:IsA('Model') then
   local root=model:FindFirstChild('HumanoidRootPart') or model.PrimaryPart
   if root and root:IsA('BasePart') then return root.Position end
  end
 end
 return record.Position
end
local function groundedPosition(position,character,root,humanoid)
 local map=workspace:FindFirstChild('_MAP')
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Include
 params.FilterDescendantsInstances=map and {map,workspace.Terrain} or {workspace.Terrain}
 params.RespectCanCollide=true
 local hit=workspace:Raycast(position+Vector3.new(0,20,0),Vector3.new(0,-250,0),params)
 if not hit or hit.Normal.Y<.5 then return nil end
 local clearance=humanoid.HipHeight+root.Size.Y/2
 if humanoid.RigType==Enum.HumanoidRigType.R6 then
  local leg=character:FindFirstChild('Left Leg') or character:FindFirstChild('Right Leg')
  clearance=clearance+(leg and leg:IsA('BasePart') and leg.Size.Y or 2)
 end
 return Vector3.new(position.X,hit.Position.Y+clearance+.05,position.Z)
end
local function availableTargets(info,position)
 local result={}
 if info then
  for _,part in ipairs(info.instances) do
   if livePart(part) then table.insert(result,{part=part,info=info,distance=(positionOf(part)-position).Magnitude,hp=tonumber(part:GetAttribute('HP'))}) end
  end
 end
 return result
end
local function selectBoss(position)
 local order=decodeList('farm.bossOrder')
 if #order==0 then for id in pairs(catalogCache.bosses) do table.insert(order,id) end; table.sort(order) end
 if previousBoss and (not livePart(previousBoss) or defeatedParts[previousBoss]) then defeatedParts[previousBoss]=nil; bossCursor=bossCursor+1; previousBoss=nil end
 if #order==0 then return nil end
 bossCursor=((bossCursor-1)%#order)+1
 local pool={}
 for offset=0,#order-1 do
  local index=((bossCursor+offset-1)%#order)+1
  local entries=availableTargets(catalogCache.bosses[order[index]],position)
  if #entries>0 and config['boss.priorityEnabled'] then
   table.sort(entries,function(a,b) return a.distance<b.distance end)
   bossCursor=index; return entries[1]
  end
  for _,entry in ipairs(entries) do table.insert(pool,entry) end
 end
 table.sort(pool,function(a,b) return a.distance<b.distance end)
 return pool[1]
end
local mobCycle={signature='',cursor=1,current=nil,total=0,available=0}
local recentlyVisited=setmetatable({},{__mode='k'})
local function selectMob(position)
 local selected=decodeList('farm.npcSelection')
 local ids={}
 local included={}
 for _,id in ipairs(selected) do
  local info=catalogCache.npcs[id]
  if info and not included[id] and worldIsSelected(info.world) then
   table.insert(ids,id); included[id]=true
  end
 end
 if config['farm.weakToStrong'] then
  sortNPCs(ids)
 else
  local first=table.find(ids,config['farm.priority'])
  if first then local id=table.remove(ids,first); table.insert(ids,1,id) end
 end
 local signature=HttpService:JSONEncode({ids,config['farm.worlds'],config['farm.mode']})
 if signature~=mobCycle.signature then
  mobCycle={signature=signature,cursor=1,current=nil,total=0,available=0}
 end
 if #ids==0 then return nil end
 local availableCount=0
 for _,id in ipairs(ids) do
  if #availableTargets(catalogCache.npcs[id],position)>0 then availableCount=availableCount+1 end
 end
 mobCycle.total=#ids; mobCycle.available=availableCount
 local now=os.clock()
 local active=mobCycle.current
 if active then
  if livePart(active.part) and not defeatedParts[active.part] then
   active.hp=tonumber(active.part:GetAttribute('HP'))
   active.distance=(positionOf(active.part)-position).Magnitude
   active.info=catalogCache.npcs[active.info.world..'::'..active.info.id] or active.info
   return active
  end
  defeatedParts[active.part]=nil
  recentlyVisited[active.part]=now
  mobCycle.cursor=(mobCycle.cursor%#ids)+1
  mobCycle.current=nil
 end
 for offset=0,#ids-1 do
  local index=((mobCycle.cursor+offset-1)%#ids)+1
  local entries=availableTargets(catalogCache.npcs[ids[index]],position)
  table.sort(entries,function(a,b)
   local aVisited=recentlyVisited[a.part]~=nil and now-recentlyVisited[a.part]<30
   local bVisited=recentlyVisited[b.part]~=nil and now-recentlyVisited[b.part]<30
   if aVisited~=bVisited then return not aVisited end
   if config['farm.mode']=='End Game' and a.hp~=b.hp then return a.hp<b.hp end
   return a.distance<b.distance
  end)
  if #entries>0 then
   mobCycle.cursor=index; mobCycle.current=entries[1]
   return entries[1]
  end
 end
 return nil
end
