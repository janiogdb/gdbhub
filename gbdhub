local catalogCache={worlds={},bosses={},npcs={}}
local function strengthOf(info)
 if not info then return nil end
 local maximum=tonumber(info.maxHP)
 for _,record in ipairs(info.instances or {}) do
  if record.Parent then
   local hp=tonumber(record:GetAttribute('MaxHP'))
   if hp and hp>0 then maximum=math.max(maximum or 0,hp) end
  end
 end
 return maximum and maximum>0 and maximum or nil
end
local function sortNPCs(ids)
 local metrics={}
 local allHaveHP=true
 for _,id in ipairs(ids) do
  local info=catalogCache.npcs[id]
  local hp=strengthOf(info)
  if not hp then allHaveHP=false end
  metrics[id]={hp=hp or math.huge,order=info and tonumber(info.order) or math.huge}
 end
 table.sort(ids,function(a,b)
  local x,y=metrics[a],metrics[b]
  local infoX,infoY=catalogCache.npcs[a],catalogCache.npcs[b]
  local secretX=infoX and (infoX.secret==true or string.lower(infoX.rarity or '')=='secret') or false
  local secretY=infoY and (infoY.secret==true or string.lower(infoY.rarity or '')=='secret') or false
  if secretX~=secretY then return not secretX end
  if allHaveHP and x.hp~=y.hp then return x.hp<y.hp end
  if x.order~=y.order then return x.order<y.order end
  if x.hp~=y.hp then return x.hp<y.hp end
  return a<b
 end)
end
