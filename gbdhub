 table.sort(rows,function(a,b) if a.obj.LayoutOrder~=b.obj.LayoutOrder then return a.obj.LayoutOrder<b.obj.LayoutOrder end; return a.order<b.order end)
 local currentTask,category=nil,''
 for _,row in ipairs(rows) do
  local obj=row.obj
  if obj.Visible then
   if obj.Name=='Category' then category=titleOf(obj); currentTask=nil end
   if obj.Name=='Task' then
    local claimed=obj:FindFirstChild('Claimed')
    currentTask={type=tostring(obj:GetAttribute('Type') or category),world=tostring(obj:GetAttribute('Map') or world),title=titleOf(obj),claimed=claimed and claimed:IsA('GuiObject') and effectiveVisibility(claimed) or false}
    table.insert(report.tasks,currentTask)
   elseif obj.Name=='List' then
    local buttons=obj:FindFirstChild('Buttons')
    if buttons then
     for _,card in ipairs(buttons:GetChildren()) do
      if card:IsA('GuiObject') and card.Name~='Template' then
       local entry={id=card.Name,type=currentTask and currentTask.type or category,world=currentTask and currentTask.world or world,name=card.Name,state='unknown',texts={},attributes={},indicators={},nameState='unknown'}
       for key,value in pairs(card:GetAttributes()) do
        if type(value)=='string' or type(value)=='number' or type(value)=='boolean' then entry.attributes[key]=value end
       end
       local known=catalogCache.npcs[entry.world..'::'..entry.id]
       if known then entry.name=known.name end
       for _,label in ipairs(card:GetDescendants()) do
        if label:IsA('GuiObject') then
         local indicator=string.lower(label.Name)
         if string.find(indicator,'lock',1,true) or string.find(indicator,'owned',1,true) or string.find(indicator,'check',1,true) or string.find(indicator,'complete',1,true) or string.find(indicator,'obtained',1,true) then
          table.insert(entry.indicators,{name=label.Name,ownVisible=label.Visible,visible=effectiveVisibility(label)})
