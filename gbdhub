end
local function mergeCatalog(data)
 assert(type(data)=='table' and data.version==1 and type(data.npcs)=='table','Formato de catálogo inválido.')
 local added=0
 for index,info in ipairs(data.npcs) do
  if index>10000 then break end
  if type(info)=='table' and type(info.name)=='string' and type(info.world)=='string' and type(info.id)=='string' then
   local key=info.world..'::'..info.id
   if not knownNPCs[key] then
    knownNPCs[key]={name=info.name,world=info.world,id=info.id,rarity=type(info.rarity)=='string' and info.rarity or '',order=tonumber(info.order) or 0,maxHP=tonumber(info.maxHP),isBoss=info.isBoss==true,secret=info.secret==true,alive=0,available=false,instances={}}
    added=added+1
   end
  end
 end
 return added
end
