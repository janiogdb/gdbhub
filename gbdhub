local function initialize()
local config, controls, profiles = {}, {}, {}
local requestSave
local function settingsSnapshot()
 local result={}
 for key,value in pairs(config) do
  if key~='profile.json' and key~='catalog.saved' then result[key]=value end
 end
 return result
end
local function applySettings(data)
 for key,value in pairs(data) do
  if key~='profile.json' and controls[key] and type(value)==type(config[key]) then
   config[key]=value; controls[key]()
  end
 end
end
local colors = {bg=Color3.fromRGB(8,6,12), card=Color3.fromRGB(20,14,27), text=Color3.fromRGB(242,232,250), accent=Color3.fromRGB(166,32,245), gold=Color3.fromRGB(232,184,78)}
local make
local images={}
local function loadImages(data)
 if type(writefile)~='function' or type(getcustomasset)~='function' then return false end
 local alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
 local values={}; for i=1,#alphabet do values[string.byte(alphabet,i)]=i-1 end
 local function decode(encoded)
  local chunks={}
  for i=1,#encoded,4 do
   local a=values[string.byte(encoded,i)] or 0
   local b=values[string.byte(encoded,i+1)] or 0
   local c=values[string.byte(encoded,i+2)] or 0
   local d=values[string.byte(encoded,i+3)] or 0
   local n=a*262144+b*4096+c*64+d
   local piece=string.char(math.floor(n/65536)%256)
   if string.sub(encoded,i+2,i+2)~='=' then piece=piece..string.char(math.floor(n/256)%256) end
   if string.sub(encoded,i+3,i+3)~='=' then piece=piece..string.char(n%256) end
   chunks[#chunks+1]=piece
  end
  return table.concat(chunks)
 end
 local okCount=0
 for name,encoded in pairs(data) do
  local ok,content=pcall(decode,encoded)
  if ok then
   local filename='GDBHub-v34-'..name..'.png'
   local saved=pcall(writefile,filename,content)
   if saved then
    local loaded,id=pcall(getcustomasset,filename)
    if loaded then images[name]=id; okCount=okCount+1 end
   end
  end
 end
 return okCount==#data
end
local function drawIcon(parent,kind,position,size)
 local imageName=kind=='sword' and 'farm_sword' or kind=='swords' and 'heroes_swords' or kind
 local image=images[imageName]
 if image then return make('ImageLabel',{Name='Icon',Position=position,Size=size,BackgroundTransparency=1,Image=image,ScaleType=Enum.ScaleType.Fit,Active=false},parent) end
 if kind=='backpack' then
  local icon=make('Frame',{Name='Icon',Position=position,Size=size,BackgroundTransparency=1,Active=false},parent)
  local function piece(x,y,w,h,color)
   local p=make('Frame',{Position=UDim2.fromScale(x,y),Size=UDim2.fromScale(w,h),BackgroundColor3=color,BorderSizePixel=0,Active=false},icon)
   make('UICorner',{CornerRadius=UDim.new(.15,0)},p); return p
  end
  local purple=Color3.fromRGB(204,108,250)
  local handle=piece(.34,.05,.32,.24,colors.card); make('UIStroke',{Color=purple,Thickness=2},handle)
  piece(.12,.29,.11,.54,purple); piece(.77,.29,.11,.54,purple)
  local bag=piece(.22,.22,.56,.69,purple)
  make('UIGradient',{Color=ColorSequence.new(Color3.fromRGB(230,160,255),Color3.fromRGB(148,25,214)),Rotation=90},bag)
  piece(.29,.58,.42,.24,Color3.fromRGB(70,21,104)); piece(.33,.64,.34,.035,Color3.fromRGB(236,186,255))
  return icon
 end
 return nil
end
