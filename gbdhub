          entry.nameState,entry.nameColor=nameState(label)
          if text~='' and text~='???' then entry.name=text end
         end
         local left,right=string.match(text,'^%s*([^/]+)%s*/%s*([^/]+)%s*$')
         if left and right then
          local current,currentError=displayedNumber(left)
          local required,requiredError=displayedNumber(right)
          if current and required and required>0 then
           entry.current=current; entry.required=required; entry.counter=text
           if current-currentError>=required+requiredError then entry.state='complete'
           elseif current+currentError<required-requiredError then entry.state='pending'
           else entry.state='unknown' end
          end
         end
        end
       end
