local watchedPart
local targetConnections={}
local deathQueued=false
local function watchTarget(part)
 if watchedPart==part then return end
 for _,connection in ipairs(targetConnections) do connection:Disconnect() end
 targetConnections={}; watchedPart=part
 if not part then return end
 local function onStateChanged()
  if not livePart(part) then
   defeatedParts[part]=true
   if not deathQueued then
    deathQueued=true
    task.defer(function()
     deathQueued=false
     if gui.Parent and movementStep then movementStep() end
    end)
   end
  end
 end
 table.insert(targetConnections,part:GetAttributeChangedSignal('HP'):Connect(onStateChanged))
 table.insert(targetConnections,part:GetAttributeChangedSignal('Dead'):Connect(onStateChanged))
 table.insert(targetConnections,part.AncestryChanged:Connect(onStateChanged))
end
movementStep=function()
 if not gui.Parent then return end
 local ok,err=xpcall(function()
   if not config['farm.1'] and not config['farm.2'] then watchTarget(nil); mobCycle.current=nil; mobCycle.signature=''; movementStatus.Text='Deslocamento desligado. Ataque automático não integrado.'; return end
   local character=player.Character
   local root=character and character:FindFirstChild('HumanoidRootPart')
   local humanoid=character and character:FindFirstChildOfClass('Humanoid')
   if not root or not humanoid or humanoid.Health<=0 then movementStatus.Text='Aguardando personagem vivo.'; return end
   local target
   if config['farm.2'] then target=selectBoss(root.Position); if target then previousBoss=target.part end end
   local bossMode=target~=nil
   if not target and config['farm.1'] then target=selectMob(root.Position) end
   if not target then watchTarget(nil); movementStatus.Text='Sem alvo disponível. Selecione NPCs e atualize o catálogo no mundo desejado.'; return end
   watchTarget(target.part)
   local currentName=target.part:GetAttribute('Name')
   if type(currentName)=='string' and currentName~='' then target.info.name=currentName end
   local destination=positionOf(target.part)
   local detail='alvo individual'
   if not bossMode and config['farm.mode']=='Spot / Alcance' then
    local group=availableTargets(target.info,destination)
    table.sort(group,function(a,b) return a.distance<b.distance end)
    local points={}
    for _,entry in ipairs(group) do
     if #points<4 then table.insert(points,positionOf(entry.part)) end
    end
    if #points<4 then
     destination=positionOf(target.part)
     detail='alvo individual ('..tostring(#points)..'/4 vivos do tipo)'
    else
     destination=Vector3.zero
     for _,point in ipairs(points) do destination=destination+point end
     destination=destination/4
     detail='centro do grupo 4/4'
    end
   else
    destination=positionOf(target.part)
   end
   destination=groundedPosition(destination,character,root,humanoid)
   if not destination then movementStatus.Text='Chão do mapa não encontrado no destino. Aguardando carregamento.'; return end
   if (root.Position-destination).Magnitude>3 then
    humanoid.Jump=false
    local desiredRoot=CFrame.new(destination)*root.CFrame.Rotation
    character:PivotTo(desiredRoot*root.CFrame:Inverse()*character:GetPivot())
    root.AssemblyLinearVelocity=Vector3.zero
    root.AssemblyAngularVelocity=Vector3.zero
   end
   local cycleText=not bossMode and string.format(' - ciclo %d/%d - %d tipos disponíveis',mobCycle.cursor,mobCycle.total or 0,mobCycle.available or 0) or ''
   movementStatus.Text=target.info.name..' - '..detail..cycleText..'\nAtaque não integrado. O servidor pode corrigir o movimento local.'
  end,debug.traceback)
  if not ok then
   config['farm.1']=false; config['farm.2']=false
   controls['farm.1'](); controls['farm.2']()
   movementStatus.Text='Deslocamento interrompido por erro.'
   reportFailure(err)
  end
end
