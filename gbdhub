local function plainCatalog(includeStorage)
 local list={}
 for key,info in pairs(knownNPCs) do
  table.insert(list,{key=key,name=info.name,world=info.world,id=info.id,rarity=info.rarity,order=info.order,maxHP=info.maxHP,isBoss=info.isBoss==true,secret=info.secret==true})
 end
 table.sort(list,function(a,b) return a.key<b.key end)
 local data={version=1,npcs=list}
 if includeStorage then data.settings=settingsSnapshot(); data.profiles=table.clone(profiles) end
