local function cleanText(value) return (string.gsub(value or '','<[^>]*>','')) end
local function nameState(label)
 local color=label.TextColor3
 local hex=string.match(label.Text,'color%s*=%s*[\"\']#(%x%x%x%x%x%x)[\"\']')
 if hex then color=Color3.fromRGB(tonumber(string.sub(hex,1,2),16),tonumber(string.sub(hex,3,4),16),tonumber(string.sub(hex,5,6),16)) end
 local gradient=label:FindFirstChildOfClass('UIGradient')
 if not hex and gradient and gradient.Enabled then
  local r,g,b,n=0,0,0,0
  for _,point in ipairs(gradient.Color.Keypoints) do r=r+point.Value.R; g=g+point.Value.G; b=b+point.Value.B; n=n+1 end
  if n>0 then color=Color3.new(color.R*r/n,color.G*g/n,color.B*b/n) end
 end
 local state='unknown'
 if color.G>.35 and color.G>color.R*1.2 and color.G>color.B*1.1 then state='green'
 elseif color.R>.35 and color.R>color.G*1.2 and color.R>color.B*1.1 then state='red' end
 return state,{r=color.R,g=color.G,b=color.B}
end
local function displayedNumber(value)
 local text=string.upper((string.gsub(value or '',',','')))
 local number,suffix=string.match(text,'^%s*([%d%.]+)%s*([KMBT]?)%s*$')
 local parsed=tonumber(number)
 if not parsed then return nil end
 local multiplier=({K=1e3,M=1e6,B=1e9,T=1e12})[suffix] or 1
 local decimals=string.match(number,'%.(%d+)')
 local uncertainty=suffix~='' and multiplier/(10^(decimals and #decimals or 0)) or 0
 return parsed*multiplier,uncertainty
end
