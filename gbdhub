 local mergeEnabled=false
 local mergeButton=button(heroes,'')
 local paintMerge=switchVisual(mergeButton,'Auto Merge All'); paintMerge(false)
 local mergeStatus=make('TextLabel',{Size=UDim2.new(1,0,0,110),BackgroundColor3=colors.card,TextColor3=colors.text,TextWrapped=true,Font=Enum.Font.Gotham,TextSize=12,Text='Abra Warriors no inventário. A união usa o Merge All do jogo e consome cópias dos dois tipos.'},heroes)
 local function renderMerge()
  paintMerge(mergeEnabled)
 end
 local function visibleMerge(obj)
  local current=obj
  while current and current~=pg do
   if current:IsA('GuiObject') and not current.Visible then return false end
   if current:IsA('ScreenGui') and not current.Enabled then return false end
   current=current.Parent
  end
  return current==pg
 end
 mergeButton.Activated:Connect(function()
  if not mergeEnabled and type(firesignal)~='function' then
   mergeStatus.Text='Este ambiente não oferece firesignal. O Merge All não foi acionado.'
   return
  end
  mergeEnabled=not mergeEnabled
  renderMerge()
  mergeStatus.Text=mergeEnabled and 'Ativado. Aguardando inventário Warriors aberto no modo normal.' or 'Desativado. Nenhum novo acionamento será enviado.'
 end)
 task.spawn(function()
  while gui.Parent do
   if mergeEnabled then
    local ok,err=pcall(function()
     local center=pg:FindFirstChild('CenterGUI')
     local inventory=center and center:FindFirstChild('Inventory')
     if not inventory or inventory:GetAttribute('Category')~='Warrior' or inventory:GetAttribute('Mode')~='Normal' then
      mergeStatus.Text='Aguardando Warriors aberto no modo normal; não interfere na seleção manual.'
      return
     end
     local main=inventory:FindFirstChild('Main')
     local content=main and main:FindFirstChild('Content')
     local topActions=content and content:FindFirstChild('Top')
     local actions=topActions and topActions:FindFirstChild('Actions')
     local nativeButton=actions and actions:FindFirstChild('MergeAll')
     if not nativeButton or not nativeButton:IsA('GuiButton') or not nativeButton.Active or not visibleMerge(nativeButton) then
      mergeStatus.Text='Aguardando botão Merge All visível e ativo no inventário.'
      return
     end
     firesignal(nativeButton.MouseButton1Click)
     mergeStatus.Text='Clique solicitado ao Merge All. Confira o resultado no jogo; o hub não confirma a união nem aceita diálogos automaticamente.'
    end)
    if not ok then
     mergeEnabled=false; renderMerge()
     mergeStatus.Text='Auto Merge desligado por erro: '..tostring(err)
    end
   end
   task.wait(3)
  end
 end)
 gui.Destroying:Connect(function() mergeEnabled=false end)
end

