 local summary=make('TextLabel',{Size=UDim2.new(1,0,0,190),BackgroundColor3=colors.card,TextColor3=colors.text,Font=Enum.Font.Gotham,TextSize=14,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left},statsPage)
 local function refreshStats()
  local total,alive,bosses=0,0,0
  for _,info in pairs(catalogCache.npcs) do total=total+1; alive=alive+(tonumber(info.alive) or 0) end
  for _ in pairs(catalogCache.bosses) do bosses=bosses+1 end
  summary.Text='Mundos no catálogo: '..tostring(#catalogCache.worlds)..'\nTipos de NPC: '..total..'\nNPCs vivos na última detecção: '..alive..'\nBosses candidatos: '..bosses..'\n\nDados carregados pelo cliente.'
 end
 button(statsPage,'Atualizar estatísticas').Activated:Connect(refreshStats)
 refreshStats()
end

