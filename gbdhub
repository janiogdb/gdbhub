local function scanCatalog()
 if scanning or not gui.Parent then return end
 scanning=true; catalogMessage='Buscando...'
 local ok,err=xpcall(function()
  local enemyFolder=workspace:FindFirstChild('_ENEMIES')
  local server=enemyFolder and enemyFolder:FindFirstChild('Server')
  local maps=workspace:FindFirstChild('_MAP')
  local worlds,npcs,bosses={},{},{}
  for key,previous in pairs(knownNPCs) do
   local info=table.clone(previous)
   info.instances={}; info.alive=0; info.available=false
   npcs[key]=info
   worlds[info.world]=true
   if info.isBoss then bosses[key]=info end
  end
  local seen,records=0,0
  local excluded={Gamemode=true,GlobalBoss=true}
  for _,container in ipairs({maps or false,server or false}) do
   if container then
    for _,folder in ipairs(container:GetChildren()) do
     if folder:IsA('Folder') and not excluded[folder.Name] then worlds[folder.Name]=true end
    end
   end
  end
  if server then
   for _,obj in ipairs(server:GetDescendants()) do
    seen=seen+1
    if obj:IsA('BasePart') then
     local id=obj:GetAttribute('Id')
     local name=obj:GetAttribute('Name')
     local world=obj:GetAttribute('Map')
     if id~=nil and type(name)=='string' and name~='' and type(world)=='string' and world~='' then
      records=records+1
      if not excluded[world] then worlds[world]=true end
      local key=world..'::'..tostring(id)
      local info=npcs[key]
      local rarity=tostring(obj:GetAttribute('Rarity') or '')
      local kind=string.lower(tostring(obj:GetAttribute('Type') or ''))
      local secret=string.lower(rarity)=='secret'
      local boss=secret or kind=='boss' or kind=='secretboss' or obj:GetAttribute('IsBoss')==true or CollectionService:HasTag(obj,'Boss')
      if not info then
       info={name=name,world=world,id=tostring(id),rarity=rarity,order=tonumber(obj:GetAttribute('Order')) or 0,instances={},alive=0,secret=secret,isBoss=boss}
